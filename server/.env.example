# Port d'écoute du serveur (défaut 3001)
PORT=3001

# Origine(s) CORS autorisée(s). En dev, laisser vide (autorise tout).
# En prod, mettre l'URL exacte du frontend, ex: https://leconseil.example.com
CORS_ORIGIN=

# Durées des phases pilotées par le serveur, en millisecondes.
# Les valeurs ci-dessous sont les défauts ; les raccourcir pour tester vite.
PHASE_CRISIS_MS=8000
PHASE_NEGOTIATION_MS=90000
PHASE_POWERS_MS=30000
PHASE_VOTE_MS=25000
PHASE_RESOLUTION_MS=12000
